<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!-- Formulaire d'un relevé kilométrique. Contrôleur : DialogueKilometrageController. -->
<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carnetentretien.carnetentretien.controller.dialogue.DialogueKilometrageController">
  <stylesheets>
    <URL value="@../style.css" />
  </stylesheets>
  <padding>
    <Insets bottom="4.0" left="10.0" right="10.0" top="6.0" />
  </padding>

  <Label styleClass="texte-doux, intro-dialogue" text="Regardez le compteur de votre voiture et notez le nombre affiché. Chaque relevé est conservé dans l'historique kilométrique." wrapText="true" />

  <VBox spacing="6.0">
    <Label styleClass="question-champ" text="Quelle est la date du relevé ?" />
    <DatePicker fx:id="dateReleve" maxWidth="Infinity" />
    <Label styleClass="aide-champ" text="Aujourd'hui est déjà choisi. La date ne peut pas être dans le futur." wrapText="true" />
  </VBox>

  <VBox spacing="6.0">
    <Label styleClass="question-champ" text="Que indique le compteur ?" />
    <TextField fx:id="champ" maxWidth="Infinity" promptText="Ex : 45000" />
    <Label styleClass="aide-champ" text="Écrivez uniquement des chiffres, sans le « km »." wrapText="true" />
  </VBox>

  <VBox spacing="6.0">
    <Label styleClass="question-champ" text="Une remarque ? (facultatif)" />
    <TextField fx:id="note" maxWidth="Infinity" promptText="Ex : après un long trajet, contrôle du compteur…" />
  </VBox>
</VBox>
