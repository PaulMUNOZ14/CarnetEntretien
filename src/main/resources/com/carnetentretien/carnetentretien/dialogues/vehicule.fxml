<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Formulaire d'ajout/modification d'un véhicule. Contrôleur : DialogueVehiculeController. -->
<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carnetentretien.carnetentretien.controller.dialogue.DialogueVehiculeController">
  <stylesheets>
    <URL value="@../style.css" />
  </stylesheets>
  <padding>
    <Insets bottom="4.0" left="10.0" right="10.0" top="6.0" />
  </padding>

  <Label styleClass="texte-doux, intro-dialogue" text="Commencez par la plaque : nous retrouvons la marque, le modèle et une photo. Pas de plaque sous la main ? Remplissez simplement les cases à la main." wrapText="true" />

  <VBox spacing="6.0">
    <Label styleClass="question-champ" text="Plaque d'immatriculation" />
    <HBox alignment="CENTER_LEFT" spacing="12.0">
      <TextField fx:id="plaque" maxWidth="Infinity" onAction="#rechercher" promptText="AB-123-CD" styleClass="champ-plaque" HBox.hgrow="ALWAYS" />
      <Button fx:id="btnRecherche" onAction="#rechercher" styleClass="btn, btn-primaire, btn-moyen" text="🔍  Rechercher" />
    </HBox>
    <Label styleClass="aide-champ" text="Facultatif, mais c'est elle qui permet d'afficher la photo de votre voiture." wrapText="true" />
  </VBox>

  <FlowPane hgap="18.0" vgap="12.0" styleClass="apercu-vehicule">
    <StackPane maxHeight="120.0" maxWidth="200.0" minHeight="120.0" minWidth="200.0" prefHeight="120.0" prefWidth="200.0" styleClass="photo-cadre">
      <Label fx:id="repli" styleClass="carte-icone" text="🚗" />
      <ImageView fx:id="photo" fitHeight="110.0" fitWidth="180.0" preserveRatio="true" visible="false" />
    </StackPane>
    <VBox prefWidth="380.0" spacing="6.0">
      <Label fx:id="apercuTitre" styleClass="apercu-titre" wrapText="true" />
      <Label fx:id="apercuDetail" styleClass="apercu-detail" wrapText="true" />
      <Label fx:id="apercuStatut" wrapText="true" />
      <FlowPane hgap="10.0" vgap="8.0">
        <Button fx:id="btnPhoto" onAction="#choisirPhoto" styleClass="btn, btn-secondaire, btn-moyen" text="📁  Choisir ma propre photo…" />
        <Button fx:id="btnRetirerPhoto" managed="false" onAction="#retirerPhoto" styleClass="btn, btn-secondaire, btn-moyen" text="✖  Retirer ma photo" visible="false" />
      </FlowPane>
    </VBox>
  </FlowPane>

  <FlowPane hgap="18.0" vgap="12.0">
    <VBox prefWidth="300.0" spacing="6.0">
      <Label styleClass="question-champ" text="Marque" />
      <TextField fx:id="marque" promptText="Ex : Renault" />
    </VBox>
    <VBox prefWidth="300.0" spacing="6.0">
      <Label styleClass="question-champ" text="Modèle" />
      <TextField fx:id="modele" promptText="Ex : Clio" />
    </VBox>
  </FlowPane>

  <FlowPane hgap="18.0" vgap="12.0">
    <VBox prefWidth="300.0" spacing="6.0">
      <Label styleClass="question-champ" text="Kilomètres au compteur" />
      <TextField fx:id="kmCompteur" promptText="Ex : 45000" />
      <Label fx:id="aideKmCompteur" styleClass="aide-champ" text="Chiffres uniquement. Ex : 45000" wrapText="true" />
    </VBox>
    <VBox prefWidth="300.0" spacing="6.0">
      <Label styleClass="question-champ" text="Kilomètres par an (environ)" />
      <TextField fx:id="kmAnnuel" promptText="Ex : 12000" />
      <Label styleClass="aide-champ" text="Au doute, gardez 12000 : c'est la moyenne en France." wrapText="true" />
    </VBox>
  </FlowPane>
</VBox>
