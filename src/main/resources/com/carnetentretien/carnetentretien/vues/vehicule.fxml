<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Écran d'un véhicule : photo, plaque, jauges d'usure et historique. Contrôleur : VehiculeController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carnetentretien.carnetentretien.controller.vue.VehiculeController">

  <stylesheets>
    <URL value="@../style.css" />
  </stylesheets>

  <FlowPane alignment="CENTER_LEFT" hgap="12.0" vgap="10.0" styleClass="entete">
    <Button onAction="#retourAccueil" styleClass="btn, btn-secondaire" text="⬅  Retour à mes véhicules" />
    <Region HBox.hgrow="ALWAYS" />
    <Button onAction="#ouvrirCalendrier" styleClass="btn, btn-secondaire" text="📅  Calendrier" />
    <Button onAction="#ouvrirCleApi" styleClass="btn, btn-discret" text="🔑  Clé API" />
    <Button onAction="#ouvrirReglages" styleClass="btn, btn-discret" text="⚙  Réglages" />
  </FlowPane>

  <ScrollPane fitToWidth="true" styleClass="zone-defilement" VBox.vgrow="ALWAYS">
    <VBox spacing="22.0">
      <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="26.0" />
      </padding>

      <FlowPane alignment="CENTER_LEFT" hgap="26.0" vgap="12.0">
        <StackPane minHeight="170.0" minWidth="280.0" prefHeight="170.0" prefWidth="280.0" styleClass="photo-cadre">
          <Label fx:id="iconeVehicule" styleClass="carte-icone" text="🚗" />
          <ImageView fx:id="photoVehicule" fitHeight="160.0" fitWidth="270.0" pickOnBounds="true" preserveRatio="true" visible="false" />
        </StackPane>
        <VBox alignment="CENTER_LEFT" prefWidth="320.0" spacing="10.0" HBox.hgrow="ALWAYS">
          <Label fx:id="titreVehicule" styleClass="titre-page" wrapText="true" />
          <HBox fx:id="zonePlaque" alignment="CENTER_LEFT" />
          <Label fx:id="sousTitreVehicule" styleClass="texte-doux" wrapText="true" />
        </VBox>
      </FlowPane>

      <FlowPane hgap="12.0" vgap="12.0">
        <Button onAction="#mettreAJourKilometrage" styleClass="btn, btn-primaire, btn-moyen" text="📍  Mettre à jour le kilométrage" />
        <Button onAction="#modifierVehicule" styleClass="btn, btn-modif, btn-moyen" text="✏  Modifier" />
        <Button onAction="#supprimerVehicule" styleClass="btn, btn-danger, btn-moyen" text="🗑  Supprimer" />
      </FlowPane>

      <HBox fx:id="bandeauEtat" alignment="CENTER_LEFT" styleClass="bandeau">
        <Label fx:id="messageBandeau" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" />
      </HBox>

      <VBox spacing="6.0">
        <Label styleClass="titre-section" text="Ce qu'il faut surveiller" />
        <Label styleClass="texte-doux" text="Plus la barre est pleine, plus l'entretien approche." wrapText="true" />
      </VBox>
      <VBox fx:id="conteneurJauges" spacing="14.0" />

      <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label styleClass="titre-section" text="Historique kilométrique" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#mettreAJourKilometrage" styleClass="btn, btn-secondaire, btn-petit" text="➕  Enregistrer un relevé" />
      </HBox>
      <Label styleClass="texte-doux" text="Chaque relevé du compteur est daté. Le kilométrage actuel suit le relevé le plus récent." wrapText="true" />
      <VBox fx:id="conteneurKilometrage" spacing="10.0" />

      <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label styleClass="titre-section" text="Contrôle technique" />
        <Region HBox.hgrow="ALWAYS" />
        <Button onAction="#enregistrerControleTechnique" styleClass="btn, btn-secondaire, btn-petit" text="➕  Enregistrer un contrôle" />
      </HBox>
      <VBox fx:id="conteneurControleTechnique" spacing="10.0" />

      <HBox alignment="CENTER_LEFT" spacing="12.0">
        <Label styleClass="titre-section" text="Ce qui a déjà été fait" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="totalDepense" styleClass="texte-doux" />
      </HBox>
      <VBox fx:id="conteneurHistorique" spacing="10.0" />
    </VBox>
  </ScrollPane>

  <FlowPane alignment="CENTER" hgap="16.0" vgap="16.0" styleClass="barre-actions">
    <Button onAction="#ajouterEntretien" styleClass="btn, btn-succes, btn-grand" text="✔  J'ai fait un entretien" />
    <Button onAction="#exporterHistorique" styleClass="btn, btn-secondaire, btn-grand" text="📥  Exporter en CSV" />
  </FlowPane>
</VBox>
