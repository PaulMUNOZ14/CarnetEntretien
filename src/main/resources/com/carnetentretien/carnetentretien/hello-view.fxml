<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carnetentretien.carnetentretien.controller.DashboardController">
  <padding>
    <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
  </padding>

  <Label text="Mon Garage" textFill="#2c3e50">
    <font>
      <Font name="System Bold" size="24.0" />
    </font>
  </Label>

  <ListView fx:id="listeVehiculesUI" prefHeight="300.0" prefWidth="600.0" />

  <HBox alignment="CENTER" spacing="10.0">
    <TextField fx:id="champMarque" promptText="Marque (ex: Peugeot)" />
    <TextField fx:id="champModele" promptText="Modèle (ex: 208)" />
    <TextField fx:id="champKmActuel" promptText="Km Actuel" prefWidth="100.0" />
    <TextField fx:id="champKmAnnuel" promptText="Km Annuel" prefWidth="100.0" />
    <Button text="Ajouter" onAction="#ajouterNouveauVehicule" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
  </HBox>

</VBox>