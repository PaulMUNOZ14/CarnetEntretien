<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<SplitPane dividerPositions="0.4" prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carnetentretien.carnetentretien.controller.DashboardController">

  <VBox spacing="15.0">
    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
    <Label text="Mon Garage" textFill="#2c3e50">
      <font><Font name="System Bold" size="20.0" /></font>
    </Label>

    <ListView fx:id="listeVehiculesUI" VBox.vgrow="ALWAYS" />

    <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5;">
      <Label text="Nouveau Véhicule" style="-fx-font-weight: bold;" />
      <HBox spacing="5.0">
        <TextField fx:id="champMarque" promptText="Marque" HBox.hgrow="ALWAYS" />
        <TextField fx:id="champModele" promptText="Modèle" HBox.hgrow="ALWAYS" />
      </HBox>
      <HBox spacing="5.0">
        <TextField fx:id="champKmActuel" promptText="Km Actuel" HBox.hgrow="ALWAYS" />
        <TextField fx:id="champKmAnnuel" promptText="Km Annuel" HBox.hgrow="ALWAYS" />
      </HBox>
      <Button text="Ajouter Véhicule" onAction="#ajouterNouveauVehicule" maxWidth="Infinity" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" />
    </VBox>
  </VBox>

  <VBox fx:id="panneauDetails" spacing="15.0" disable="true">
    <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>

    <Label fx:id="titreDetails" text="Sélectionnez un véhicule" textFill="#2980b9">
      <font><Font name="System Bold" size="22.0" /></font>
    </Label>

    <Label text="Historique des entretiens :" />
    <ListView fx:id="listeEntretiensUI" VBox.vgrow="ALWAYS" />

    <VBox spacing="10.0" style="-fx-background-color: #f8f9fa; -fx-padding: 10; -fx-background-radius: 5;">
      <Label text="Ajouter une facture / opération" style="-fx-font-weight: bold;" />
      <HBox spacing="5.0">
        <TextField fx:id="champOperation" promptText="Opération (ex: Vidange)" HBox.hgrow="ALWAYS" />
        <DatePicker fx:id="champDate" promptText="Date" HBox.hgrow="ALWAYS" />
      </HBox>
      <HBox spacing="5.0">
        <TextField fx:id="champKmRealisation" promptText="Kilométrage" HBox.hgrow="ALWAYS" />
        <TextField fx:id="champCout" promptText="Coût total (€)" HBox.hgrow="ALWAYS" />
      </HBox>
      <Button text="Ajouter l'entretien" onAction="#ajouterNouvelEntretien" maxWidth="Infinity" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" />
    </VBox>
  </VBox>
</SplitPane>