<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="racine" minHeight="650.0" minWidth="1000.0" prefHeight="750.0" prefWidth="1100.0" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carnetentretien.carnetentretien.controller.DashboardController">

  <stylesheets>
    <URL value="@style.css" />
  </stylesheets>

  <!-- ===================== ÉCRAN 1 : ACCUEIL ===================== -->
  <VBox fx:id="vueAccueil">

    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="entete">
      <Label styleClass="titre-page" text="🚗  Mon carnet d'entretien" />
      <Region HBox.hgrow="ALWAYS" />
      <Button onAction="#ouvrirReglages" styleClass="btn, btn-discret" text="⚙  Réglages" />
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="zone-defilement" VBox.vgrow="ALWAYS">
      <VBox spacing="24.0">
        <padding>
          <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
        </padding>

        <Label styleClass="titre-section" text="Choisissez votre véhicule" />

        <VBox fx:id="blocBienvenue" spacing="10.0" styleClass="carte-message">
          <Label styleClass="carte-message-titre" text="👋  Bienvenue !" />
          <Label styleClass="texte-doux" text="Commençons simplement : appuyez sur le grand bouton vert « Ajouter un véhicule » en bas de l'écran." wrapText="true" />
        </VBox>

        <FlowPane fx:id="conteneurVehicules" hgap="24.0" vgap="24.0" />
      </VBox>
    </ScrollPane>

    <HBox alignment="CENTER" styleClass="barre-actions">
      <Button onAction="#ajouterVehicule" styleClass="btn, btn-succes, btn-grand" text="➕  Ajouter un véhicule" />
    </HBox>
  </VBox>

  <!-- ===================== ÉCRAN 2 : UN VÉHICULE ===================== -->
  <VBox fx:id="vueVehicule" managed="false" visible="false">

    <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="entete">
      <Button onAction="#retourAccueil" styleClass="btn, btn-secondaire" text="⬅  Retour à mes véhicules" />
      <Region HBox.hgrow="ALWAYS" />
      <Button onAction="#ouvrirReglages" styleClass="btn, btn-discret" text="⚙  Réglages" />
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="zone-defilement" VBox.vgrow="ALWAYS">
      <VBox spacing="22.0">
        <padding>
          <Insets bottom="30.0" left="40.0" right="40.0" top="26.0" />
        </padding>

        <VBox spacing="4.0">
          <Label fx:id="titreVehicule" styleClass="titre-page" wrapText="true" />
          <Label fx:id="sousTitreVehicule" styleClass="texte-doux" wrapText="true" />
        </VBox>

        <HBox spacing="12.0">
          <Button onAction="#mettreAJourKilometrage" styleClass="btn, btn-primaire, btn-moyen" text="📍  Mettre à jour le kilométrage" />
          <Button onAction="#modifierVehicule" styleClass="btn, btn-modif, btn-moyen" text="✏  Modifier" />
          <Button onAction="#supprimerVehicule" styleClass="btn, btn-danger, btn-moyen" text="🗑  Supprimer" />
        </HBox>

        <HBox fx:id="bandeauEtat" alignment="CENTER_LEFT" styleClass="bandeau">
          <Label fx:id="messageBandeau" maxWidth="Infinity" wrapText="true" HBox.hgrow="ALWAYS" />
        </HBox>

        <VBox spacing="6.0">
          <Label styleClass="titre-section" text="Ce qu'il faut surveiller" />
          <Label styleClass="texte-doux" text="Plus la barre est pleine, plus l'entretien approche." wrapText="true" />
        </VBox>
        <VBox fx:id="conteneurJauges" spacing="14.0" />

        <HBox alignment="CENTER_LEFT" spacing="12.0">
          <Label styleClass="titre-section" text="Ce qui a déjà été fait" />
          <Region HBox.hgrow="ALWAYS" />
          <Label fx:id="totalDepense" styleClass="texte-doux" />
        </HBox>
        <VBox fx:id="conteneurHistorique" spacing="10.0" />
      </VBox>
    </ScrollPane>

    <HBox alignment="CENTER" spacing="16.0" styleClass="barre-actions">
      <Button onAction="#ajouterEntretien" styleClass="btn, btn-succes, btn-grand" text="✔  J'ai fait un entretien" />
      <Button onAction="#exporterHistorique" styleClass="btn, btn-secondaire, btn-grand" text="📥  Exporter en CSV" />
    </HBox>
  </VBox>

  <!-- Message de confirmation (apparaît quelques secondes puis disparaît) -->
  <Label fx:id="toast" mouseTransparent="true" styleClass="toast" visible="false" StackPane.alignment="BOTTOM_CENTER">
    <StackPane.margin>
      <Insets bottom="120.0" />
    </StackPane.margin>
  </Label>

</StackPane>
