<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="700.0" prefWidth="1150.0" styleClass="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.carnetentretien.carnetentretien.controller.DashboardController">

  <stylesheets>
    <URL value="@style.css" />
  </stylesheets>

  <VBox minWidth="350.0" prefWidth="350.0" spacing="20.0" styleClass="sidebar">

    <HBox alignment="CENTER_LEFT" spacing="10.0">
      <Label styleClass="header-title" text="Mon Garage" HBox.hgrow="ALWAYS" />
      <Region HBox.hgrow="ALWAYS" />
      <Button onAction="#ouvrirParametresPreconisations" style="-fx-font-size: 12px; -fx-padding: 5 10;" styleClass="btn, btn-edit" text="Règles" />
    </HBox>

    <ListView fx:id="listeVehiculesUI" VBox.vgrow="ALWAYS" />

    <VBox spacing="15.0" styleClass="card">
      <Label styleClass="section-title" text="Nouveau véhicule" />
      <HBox spacing="10.0">
        <TextField fx:id="champMarque" promptText="Marque" HBox.hgrow="ALWAYS" />
        <TextField fx:id="champModele" promptText="Modèle" HBox.hgrow="ALWAYS" />
      </HBox>
      <HBox spacing="10.0">
        <TextField fx:id="champKmActuel" promptText="Km Actuel" HBox.hgrow="ALWAYS" />
        <TextField fx:id="champKmAnnuel" promptText="Km / An" HBox.hgrow="ALWAYS" />
      </HBox>
      <Button maxWidth="Infinity" onAction="#ajouterNouveauVehicule" styleClass="btn, btn-success" text="+ Enregistrer le véhicule" />
    </VBox>
  </VBox>

  <BorderPane fx:id="panneauDetails" disable="true" HBox.hgrow="ALWAYS">
    <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <top>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
        <padding><Insets bottom="20.0" /></padding>

        <Label fx:id="titreDetails" styleClass="header-title" text="Sélectionnez un véhicule" HBox.hgrow="ALWAYS" />

        <Region HBox.hgrow="ALWAYS" />

        <Button onAction="#modifierVehiculeSelectionne" styleClass="btn, btn-edit" text="✎ Modifier Vehicule" />
        <Button onAction="#supprimerVehiculeSelectionne" styleClass="btn, btn-delete" text="✖ Supprimer Vehicule" />
      </HBox>
    </top>

    <center>
      <VBox spacing="15.0" styleClass="card">
        <HBox alignment="CENTER_LEFT" spacing="10.0">
          <Label styleClass="section-title" text="Historique des opérations" HBox.hgrow="ALWAYS" />
          <Region HBox.hgrow="ALWAYS" />
          <Button onAction="#modifierEntretienSelectionne" styleClass="btn, btn-edit" text="✎ Modifier Intervention" />
          <Button onAction="#supprimerEntretienSelectionne" styleClass="btn, btn-delete" text="✖ Supprimer Intervention" />
        </HBox>

        <ListView fx:id="listeEntretiensUI" VBox.vgrow="ALWAYS" />
      </VBox>
    </center>

    <bottom>
      <VBox spacing="15.0" styleClass="card">
        <BorderPane.margin><Insets top="20.0" /></BorderPane.margin>

        <Label styleClass="section-title" text="Ajouter une facture / intervention" />

        <HBox alignment="CENTER_LEFT" spacing="15.0">
          <TextField fx:id="champOperation" promptText="Type d'opération (ex: Vidange)" HBox.hgrow="ALWAYS" />
          <DatePicker fx:id="champDate" promptText="Date d'intervention" HBox.hgrow="ALWAYS" />
          <TextField fx:id="champKmRealisation" promptText="Kilométrage" HBox.hgrow="ALWAYS" />
          <TextField fx:id="champCout" promptText="Coût TTC (€)" HBox.hgrow="ALWAYS" />

          <Button minWidth="150.0" onAction="#ajouterNouvelEntretien" styleClass="btn, btn-primary" text="+ Ajouter la facture" />
        </HBox>
      </VBox>
    </bottom>
  </BorderPane>

</HBox>